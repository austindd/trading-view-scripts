//@version=5
indicator("ROC MTF Momentum Alignment V1 [SB]", shorttitle = "ROC MTF Align", overlay = true)

// ─────────────────────────────────────────────────────────────────────────────
// Inputs
// ─────────────────────────────────────────────────────────────────────────────
GRP_ROC = "Rate of Change"
src       = input.source(close, "Source", group = GRP_ROC)
midpoint  = input.float(0.0, "Midpoint", step = 0.1, group = GRP_ROC, tooltip = "The level each ROC is compared against. 0 is the standard ROC zero line.")
deadZone  = input.float(0.0, "Dead Zone (±)", minval = 0, step = 0.01, group = GRP_ROC, tooltip = "A timeframe only counts as above when ROC > midpoint + dead zone, and below when ROC < midpoint − dead zone. Anything in between is neutral and blocks a signal.")
calcMode  = input.string("Confirmed HTF candles (no repaint)", "HTF Values", options = ["Confirmed HTF candles (no repaint)", "Developing HTF candles (repaints)"], group = GRP_ROC, tooltip = "Confirmed: each higher timeframe uses the ROC of its last CLOSED candle, so signals never repaint (but react up to one HTF candle later). Developing: uses the still-forming HTF candle; faster, but historical signals will not match what you saw live.")

GRP_TF = "Timeframes (ROC Length per TF)"
en1  = input.bool(true, "", inline = "tf1", group = GRP_TF)
tf1  = input.timeframe("5", "TF 1", inline = "tf1", group = GRP_TF)
len1 = input.int(9, "Length", minval = 1, inline = "tf1", group = GRP_TF)
en2  = input.bool(true, "", inline = "tf2", group = GRP_TF)
tf2  = input.timeframe("15", "TF 2", inline = "tf2", group = GRP_TF)
len2 = input.int(9, "Length", minval = 1, inline = "tf2", group = GRP_TF)
en3  = input.bool(true, "", inline = "tf3", group = GRP_TF)
tf3  = input.timeframe("60", "TF 3", inline = "tf3", group = GRP_TF)
len3 = input.int(9, "Length", minval = 1, inline = "tf3", group = GRP_TF)
en4  = input.bool(true, "", inline = "tf4", group = GRP_TF)
tf4  = input.timeframe("240", "TF 4", inline = "tf4", group = GRP_TF)
len4 = input.int(9, "Length", minval = 1, inline = "tf4", group = GRP_TF)
en5  = input.bool(false, "", inline = "tf5", group = GRP_TF)
tf5  = input.timeframe("D", "TF 5", inline = "tf5", group = GRP_TF)
len5 = input.int(9, "Length", minval = 1, inline = "tf5", group = GRP_TF)
en6  = input.bool(false, "", inline = "tf6", group = GRP_TF)
tf6  = input.timeframe("W", "TF 6", inline = "tf6", group = GRP_TF)
len6 = input.int(9, "Length", minval = 1, inline = "tf6", group = GRP_TF)

GRP_SIG = "Signals"
signalMode = input.string("Alignment Start", "Signal On", options = ["Alignment Start", "Every Aligned Bar"], group = GRP_SIG, tooltip = "Alignment Start: one signal on the first bar where every timeframe agrees. Every Aligned Bar: a signal on each bar while they agree.")
waitClose  = input.bool(true, "Wait For Bar Close", group = GRP_SIG, tooltip = "Only print a signal once the chart bar has closed (realtime only; historical bars are always closed).")
showBull   = input.bool(true, "Bullish Signals", inline = "bull", group = GRP_SIG)
bullColor  = input.color(color.new(#089981, 0), "", inline = "bull", group = GRP_SIG)
showBear   = input.bool(true, "Bearish Signals", inline = "bear", group = GRP_SIG)
bearColor  = input.color(color.new(#f23645, 0), "", inline = "bear", group = GRP_SIG)
showBg     = input.bool(false, "Shade Background While Aligned", group = GRP_SIG)
bgTransp   = input.int(90, "Background Transparency", minval = 0, maxval = 100, group = GRP_SIG)

GRP_TBL = "Table"
showTable = input.bool(true, "Show Table", group = GRP_TBL)
tblPosStr = input.string("Top Right", "Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right", "Middle Left"], group = GRP_TBL)
tblSizeStr = input.string("Small", "Text Size", options = ["Tiny", "Small", "Normal", "Large"], group = GRP_TBL)

GRP_ALT = "Alerts"
dynAlerts = input.bool(true, "Dynamic Alerts (any alert() function call)", group = GRP_ALT, tooltip = "Fires on each signal with every timeframe's ROC value in the message. Create the alert with the 'Any alert() function call' condition.")

// ─────────────────────────────────────────────────────────────────────────────
// ROC per timeframe
// ─────────────────────────────────────────────────────────────────────────────
noRepaint = calcMode == "Confirmed HTF candles (no repaint)"
chartSec  = timeframe.in_seconds()

// Standard ROC: 100 * (src - src[len]) / src[len]
// Chart TF is computed locally (no one-bar lag); TFs below the chart TF are skipped (na).
rocFor(string tf, int len) =>
    float localRoc = ta.roc(src, len)
    float htfRoc   = request.security(syminfo.tickerid, tf, ta.roc(src, len)[noRepaint ? 1 : 0], lookahead = noRepaint ? barmerge.lookahead_on : barmerge.lookahead_off)
    int tfSec = timeframe.in_seconds(tf)
    tfSec == chartSec ? localRoc : tfSec < chartSec ? na : htfRoc

isSkipped(string tf) => timeframe.in_seconds(tf) < chartSec

tfLabel(string tf) =>
    string t = tf == "" ? timeframe.period : tf
    int s = timeframe.in_seconds(t)
    str.contains(t, "D") or str.contains(t, "W") or str.contains(t, "M") or str.contains(t, "S") ? t : s % 3600 == 0 ? str.tostring(int(s / 3600)) + "h" : str.tostring(int(s / 60)) + "m"

r1 = rocFor(tf1, len1)
r2 = rocFor(tf2, len2)
r3 = rocFor(tf3, len3)
r4 = rocFor(tf4, len4)
r5 = rocFor(tf5, len5)
r6 = rocFor(tf6, len6)

float[]  vals  = array.from(r1, r2, r3, r4, r5, r6)
bool[]   ens   = array.from(en1, en2, en3, en4, en5, en6)
string[] tfs   = array.from(tf1, tf2, tf3, tf4, tf5, tf6)
int[]    lens  = array.from(len1, len2, len3, len4, len5, len6)

// ─────────────────────────────────────────────────────────────────────────────
// Alignment
// ─────────────────────────────────────────────────────────────────────────────
int required = 0   // enabled, not below the chart TF
int above    = 0
int below    = 0
for i = 0 to 5
    if array.get(ens, i) and not isSkipped(array.get(tfs, i))
        required += 1
        float v = array.get(vals, i)
        if not na(v)
            if v > midpoint + deadZone
                above += 1
            else if v < midpoint - deadZone
                below += 1

// A TF still warming up (na) counts as required but neither side, so it blocks signals.
bool bullAligned = required > 0 and above == required
bool bearAligned = required > 0 and below == required

bool confirmOk = not waitClose or barstate.isconfirmed
bool everyBar  = signalMode == "Every Aligned Bar"
bool bullSig   = confirmOk and bullAligned and (everyBar or not bullAligned[1])
bool bearSig   = confirmOk and bearAligned and (everyBar or not bearAligned[1])

// ─────────────────────────────────────────────────────────────────────────────
// Visuals
// ─────────────────────────────────────────────────────────────────────────────
plotshape(showBull and bullSig, "Bullish Momentum", shape.labelup,   location.belowbar, bullColor, text = "MOM", textcolor = color.white, size = size.small)
plotshape(showBear and bearSig, "Bearish Momentum", shape.labeldown, location.abovebar, bearColor, text = "MOM", textcolor = color.white, size = size.small)

bgcolor(showBg and bullAligned ? color.new(bullColor, bgTransp) : showBg and bearAligned ? color.new(bearColor, bgTransp) : na, title = "Aligned Background")

plot(r1, "ROC TF 1", display = display.data_window)
plot(r2, "ROC TF 2", display = display.data_window)
plot(r3, "ROC TF 3", display = display.data_window)
plot(r4, "ROC TF 4", display = display.data_window)
plot(r5, "ROC TF 5", display = display.data_window)
plot(r6, "ROC TF 6", display = display.data_window)

tblPos = switch tblPosStr
    "Top Left"     => position.top_left
    "Bottom Right" => position.bottom_right
    "Bottom Left"  => position.bottom_left
    "Middle Right" => position.middle_right
    "Middle Left"  => position.middle_left
    => position.top_right

tblSize = switch tblSizeStr
    "Tiny"   => size.tiny
    "Normal" => size.normal
    "Large"  => size.large
    => size.small

var table tbl = table.new(tblPos, 4, 8, bgcolor = color.new(color.black, 20), border_color = color.new(color.gray, 60), border_width = 1)

if showTable and barstate.islast
    color hdr  = color.new(color.gray, 40)
    color txt  = color.white
    color dim  = color.new(color.gray, 20)
    table.cell(tbl, 0, 0, "TF",   text_color = txt, text_size = tblSize, bgcolor = hdr)
    table.cell(tbl, 1, 0, "Len",  text_color = txt, text_size = tblSize, bgcolor = hdr)
    table.cell(tbl, 2, 0, "ROC",  text_color = txt, text_size = tblSize, bgcolor = hdr)
    table.cell(tbl, 3, 0, "Side", text_color = txt, text_size = tblSize, bgcolor = hdr)
    for i = 0 to 5
        string tf   = array.get(tfs, i)
        float  v    = array.get(vals, i)
        int    row  = i + 1
        string side = ""
        color  bg   = na
        color  fg   = txt
        if not array.get(ens, i)
            side := "off"
            fg   := dim
        else if isSkipped(tf)
            side := "< chart TF"
            fg   := dim
        else if na(v)
            side := "warming up"
            fg   := dim
        else if v > midpoint + deadZone
            side := "▲ above"
            bg   := color.new(bullColor, 60)
        else if v < midpoint - deadZone
            side := "▼ below"
            bg   := color.new(bearColor, 60)
        else
            side := "– neutral"
        table.cell(tbl, 0, row, tfLabel(tf), text_color = fg, text_size = tblSize, bgcolor = bg)
        table.cell(tbl, 1, row, str.tostring(array.get(lens, i)), text_color = fg, text_size = tblSize, bgcolor = bg)
        table.cell(tbl, 2, row, na(v) ? "—" : str.tostring(v, "#.##") + "%", text_color = fg, text_size = tblSize, bgcolor = bg)
        table.cell(tbl, 3, row, side, text_color = fg, text_size = tblSize, bgcolor = bg)
    string status = bullAligned ? "BULLISH ALIGNED" : bearAligned ? "BEARISH ALIGNED" : "Mixed (" + str.tostring(above) + "▲ / " + str.tostring(below) + "▼ of " + str.tostring(required) + ")"
    color  stBg   = bullAligned ? bullColor : bearAligned ? bearColor : hdr
    table.cell(tbl, 0, 7, status, text_color = txt, text_size = tblSize, bgcolor = stBg)
    table.merge_cells(tbl, 0, 7, 3, 7)

// ─────────────────────────────────────────────────────────────────────────────
// Alerts
// ─────────────────────────────────────────────────────────────────────────────
alertcondition(bullSig, "Bullish Momentum Alignment", "ROC MTF: all timeframes above the midpoint on {{ticker}} ({{interval}})")
alertcondition(bearSig, "Bearish Momentum Alignment", "ROC MTF: all timeframes below the midpoint on {{ticker}} ({{interval}})")

if dynAlerts and (bullSig or bearSig)
    string msg = (bullSig ? "Bullish" : "Bearish") + " ROC momentum alignment on " + syminfo.ticker + " @ " + str.tostring(close, format.mintick) + " |"
    for i = 0 to 5
        if array.get(ens, i) and not isSkipped(array.get(tfs, i))
            msg += " " + tfLabel(array.get(tfs, i)) + ": " + str.tostring(array.get(vals, i), "#.##") + "%"
    alert(msg, alert.freq_once_per_bar_close)
