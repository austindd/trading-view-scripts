//@version=5
indicator("Market Structure Supply & Demand V1 [SB]", "MS S&D V1 [SB]", overlay = true
  , max_bars_back   = 5000
  , max_boxes_count = 500)

// ============================================================================
// OVERVIEW
// ============================================================================
//
// Marks supply & demand zones derived from the actual structure of price
// action on two timeframes. No BOS/CHOCH machinery and no structure lines —
// this replaces the Market Structure Mapper's signal layer with zones only.
//
// Supply (bearish) example — demand is the exact mirror:
//
//   1. AOI (Area Of Interest), detected on the AOI timeframe:
//      A swing high (H1), a swing low (L), then a higher high (H2 > H1), and
//      finally an AOI-TF candle BODY closes below L. If a wick trades below L
//      before any body closes below it, the low is considered swept and (by
//      default) no longer qualifies. The AOI is the upside-down-V region:
//
//                H2 ─────────────┐
//               ╱  ╲             │
//          H1  ╱    ╲            │   AOI price band = [L .. H2]
//          ╱╲ ╱      ╲           │   AOI time span  = L's bar → break candle
//         ╱  ╲        ╲          │
//        ╱   L ────────╲─────────┘
//                       ╳   ← AOI-TF body close below L confirms the AOI
//
//   2. Zones, detected on the (lower) zone timeframe inside the AOI:
//      The same structure logic, one level down. Zone-TF swing points are
//      tracked through the AOI window, and every break of the NEAREST
//      structure level by a zone-TF candle BODY (a wick-first sweep again
//      disqualifies by default) produces a zone. Inside a supply AOI that is
//      an inverted-V: low #1, a local high, then a body close below low #1 —
//      the zone spans [low #1 .. local high] (the broken level to the V's
//      vertex, NOT the breaking extreme). Inside a demand AOI it is the
//      mirrored V: high #1, a local low, then a body close above high #1 —
//      zone = [local low .. high #1]. One AOI commonly yields several zones
//      as successive nearest levels form and break.
//
//   3. Lifecycle (follows S&D Zones V11): zones extend right, the fill turns
//      gray on first touch, and a zone stops extending at the bar where it is
//      fully broken (close beyond its far edge).
//
// Both timeframes are aggregated locally from chart bars via
// timeframe.change() (the fvg-mtf-origin-v1.ps pattern) rather than
// request.security(). This avoids the request.security() [1] history-offset
// trap documented in CLAUDE.md, is non-repainting, and yields the exact
// chart-bar indices needed for the retrospective zone scan that runs when an
// AOI confirms. Trade-off: chart TF <= zone TF <= AOI TF is required, and
// detection only reaches as far back as loaded chart bars.

// Ensure sufficient historical buffer for the retrospective scans
max_bars_back(high, 5000)
max_bars_back(low, 5000)
max_bars_back(open, 5000)
max_bars_back(close, 5000)
max_bars_back(time, 5000)

// ============================================================================
// INPUTS
// ============================================================================

grpTf = "Timeframes"
aoiTfInput  = input.timeframe("240", "AOI Timeframe",  group = grpTf, tooltip = "Higher timeframe on which areas of interest (the structural V / inverted-V) are detected. Must be >= the zone timeframe.")
zoneTfInput = input.timeframe("",    "Zone Timeframe", group = grpTf, tooltip = "Timeframe on which the actual zones are detected inside each AOI. Blank = chart timeframe. Must be >= the chart timeframe and <= the AOI timeframe.")

grpAoi = "AOI Detection"
invalidateAoiSweep = input.bool(true, "Wick Sweep Invalidates Structure Point", group = grpAoi, tooltip = "The first break of the structural low/high must be a body close-through. When enabled, a wick trading through the level before any body close disqualifies it from ever confirming an AOI.")
maxAois            = input.int(15, "Max AOIs Kept", minval = 1, maxval = 50, group = grpAoi)

grpZone = "Zone Detection"
invalidateZoneSweep = input.bool(true, "Wick Sweep Invalidates Structure Point", group = grpZone, tooltip = "Same rule on the zone timeframe: the first break of the nearest structure high/low must be a body close-through. A wick trading through the level before any body close disqualifies that swing point.")
zoneScope           = input.string("Overlap AOI", "Zone / AOI Relationship", options = ["Overlap AOI", "Fully Inside AOI"], group = grpZone, tooltip = "Whether a zone's price range merely has to intersect the AOI band or must sit entirely inside it.")
minAtrMult          = input.float(0.0, "Min Zone Height (ATR multiple)", minval = 0, step = 0.05, group = grpZone, tooltip = "Ignore zones smaller than ATR * this value. 0 disables the filter. ATR is measured on the chart timeframe.")
atrLen              = input.int(200, "ATR Length", minval = 1, group = grpZone)
zoneHistLen         = input.int(1000, "Zone-TF Candle History", minval = 100, maxval = 2000, group = grpZone, tooltip = "How many completed zone-TF candles are kept for the retrospective scan when an AOI confirms. AOIs whose V reaches further back than this are only partially scanned.")
maxZones            = input.int(100, "Max Zones Per Side", minval = 1, maxval = 200, group = grpZone)

grpLife = "Zone Lifecycle"
changeColorOnTouched = input.bool(true, "Change Color When Touched", group = grpLife)
breakOnWick          = input.bool(false, "Break Zones on Wick (not just close)", group = grpLife, tooltip = "A zone is fully broken when price passes completely through it. Off = requires a candle close beyond the far edge; On = a wick is enough.")

grpDisp = "Display"
showZones       = input.bool(true,  "Show Zones", group = grpDisp)
showBrokenZones = input.bool(false, "Show Broken Zones", group = grpDisp, tooltip = "Broken zones are kept in memory either way; this only controls whether they stay drawn (cut off at the breaking bar).")
showAois        = input.bool(true,  "Show AOIs", group = grpDisp, tooltip = "Draw each confirmed AOI as a dashed outline spanning its structural V.")

grpCol = "Colors"
supplyZoneColorInput   = input.color(color.new(color.red,   70), "Supply Zone Color",    group = grpCol)
supplyZoneBorderInput  = input.color(color.new(color.red,   50), "Supply Zone Border",   group = grpCol)
demandZoneColorInput   = input.color(color.new(color.green, 70), "Demand Zone Color",    group = grpCol)
demandZoneBorderInput  = input.color(color.new(color.green, 50), "Demand Zone Border",   group = grpCol)
zoneTouchedColorInput  = input.color(color.new(color.gray,  80), "Zone Touched Color",   group = grpCol)
aoiSupplyColorInput    = input.color(color.new(color.red,   40), "Supply AOI Outline",   group = grpCol)
aoiDemandColorInput    = input.color(color.new(color.green, 40), "Demand AOI Outline",   group = grpCol)
aoiFillTransp          = input.int(96, "AOI Fill Transparency", minval = 0, maxval = 100, group = grpCol)

// ============================================================================
// TIMEFRAME RESOLUTION & VALIDATION
// ============================================================================

// Kept as inline expressions so they stay "simple string", which
// timeframe.change() and timeframe.in_seconds() both require.
aoiTfRes  = aoiTfInput  == "" ? timeframe.period : aoiTfInput
zoneTfRes = zoneTfInput == "" ? timeframe.period : zoneTfInput

chartSec = timeframe.in_seconds(timeframe.period)
zoneSec  = timeframe.in_seconds(zoneTfRes)
aoiSec   = timeframe.in_seconds(aoiTfRes)

if barstate.isfirst
    if zoneSec < chartSec
        runtime.error("Zone Timeframe must be >= the chart timeframe (local aggregation cannot build candles below the chart TF).")
    if aoiSec < zoneSec
        runtime.error("AOI Timeframe must be >= the Zone Timeframe.")

// ============================================================================
// TYPE DEFINITIONS
// ============================================================================

// Locally aggregated candle history for one timeframe.
// Index 0 = most recently COMPLETED candle (unshift on period change).
type CandleHist
    array<float> oHist
    array<float> hHist
    array<float> lHist
    array<float> cHist
    array<int>   sHist        // first chart bar of the candle
    array<int>   eHist        // last chart bar of the candle
    array<int>   tHist        // chart time of the candle's first bar
    float        curOpen  = na    // developing candle
    float        curHigh  = na
    float        curLow   = na
    int          curStart = na
    int          curStartTime = na
    int          maxLen
    int          count = 0        // total candles ever pushed (sequence numbering)

// A confirmed 3-candle swing point on the AOI timeframe.
type SwingPoint
    int   seq             // AOI-TF candle sequence number of the middle candle
    float price           // the swing extreme
    int   extremeBar      // chart bar of the actual intra-candle extreme
    int   extremeTime
    bool  active = true   // false once body-broken or (optionally) wick-swept

// A confirmed area of interest (the structural V / inverted-V).
type Aoi
    int   dir             // -1 = supply, 1 = demand
    float top
    float bottom
    int   leftBar         // chart bar of the structural extreme (V start)
    int   leftTime
    int   confirmBar      // last chart bar of the body-break AOI candle
    int   confirmTime

// A supply/demand zone found inside an AOI.
type Zone
    int   dir             // -1 = supply, 1 = demand
    float top
    float bottom
    int   leftBar         // first chart bar of the candle series
    int   leftTime
    int   createdBar      // last chart bar of the zone-TF body-break candle
    bool  touched = false
    bool  broken  = false
    int   brokenTime = na

// ============================================================================
// STATE
// ============================================================================

var CandleHist zoneHist = CandleHist.new(
  oHist = array.new<float>(), hHist = array.new<float>(), lHist = array.new<float>(),
  cHist = array.new<float>(), sHist = array.new<int>(),   eHist = array.new<int>(),
  tHist = array.new<int>(),   maxLen = zoneHistLen)

var CandleHist aoiHist = CandleHist.new(
  oHist = array.new<float>(), hHist = array.new<float>(), lHist = array.new<float>(),
  cHist = array.new<float>(), sHist = array.new<int>(),   eHist = array.new<int>(),
  tHist = array.new<int>(),   maxLen = 8)

var array<SwingPoint> swingHighs = array.new<SwingPoint>()
var array<SwingPoint> swingLows  = array.new<SwingPoint>()

var array<Aoi>  aois        = array.new<Aoi>()
var array<Zone> supplyZones = array.new<Zone>()
var array<Zone> demandZones = array.new<Zone>()

// Alert flags (V11 pattern: set during the bar, read by alertcondition, reset at end)
var bool supplyAoiFlag         = false
var bool demandAoiFlag         = false
var bool supplyZoneCreatedFlag = false
var bool demandZoneCreatedFlag = false
var bool supplyTouchFlag       = false
var bool demandTouchFlag       = false
var bool supplyBreakFlag       = false
var bool demandBreakFlag       = false

var float supplyZoneCreatedTop = na
var float supplyZoneCreatedBtm = na
var float demandZoneCreatedTop = na
var float demandZoneCreatedBtm = na

// ATR must be computed on every bar for consistency
minZoneSize = minAtrMult > 0 ? nz(ta.atr(atrLen)) * minAtrMult : 0.0

zoneScopeInside = zoneScope == "Fully Inside AOI"

// ============================================================================
// AGGREGATION
// ============================================================================

// Advance one timeframe's local aggregation by one chart bar. On the first bar
// of a new period the just-completed candle (which ended on the previous chart
// bar, closing at close[1]) is pushed onto the history. Returns true when a
// completed candle was pushed.
advanceHist(CandleHist ch, bool newPeriod) =>
    bool pushed = false
    if newPeriod
        if not na(ch.curStart)
            array.unshift(ch.oHist, ch.curOpen)
            array.unshift(ch.hHist, ch.curHigh)
            array.unshift(ch.lHist, ch.curLow)
            array.unshift(ch.cHist, close[1])
            array.unshift(ch.sHist, ch.curStart)
            array.unshift(ch.eHist, bar_index - 1)
            array.unshift(ch.tHist, ch.curStartTime)
            ch.count += 1
            pushed := true
            if array.size(ch.hHist) > ch.maxLen
                array.pop(ch.oHist)
                array.pop(ch.hHist)
                array.pop(ch.lHist)
                array.pop(ch.cHist)
                array.pop(ch.sHist)
                array.pop(ch.eHist)
                array.pop(ch.tHist)
        ch.curOpen := open
        ch.curHigh := high
        ch.curLow := low
        ch.curStart := bar_index
        ch.curStartTime := time
    else
        ch.curOpen := na(ch.curOpen) ? open : ch.curOpen
        ch.curHigh := na(ch.curHigh) ? high : math.max(ch.curHigh, high)
        ch.curLow := na(ch.curLow) ? low : math.min(ch.curLow, low)
        if na(ch.curStart)
            ch.curStart := bar_index
            ch.curStartTime := time
    pushed

// ============================================================================
// CHART-BAR SCAN HELPERS
// ============================================================================

// Highest high within one aggregated candle's chart-bar range.
// Returns [price, chartBar, chartTime].
findHighestInCandle(int sBar, int eBar) =>
    float bestP = na
    int bestBar = na
    int bestT = na
    int offA = bar_index - eBar
    int offB = math.min(bar_index - sBar, 4999)
    if offA >= 0 and offA <= offB
        for j = offA to offB
            if na(bestP) or high[j] > bestP
                bestP := high[j]
                bestBar := bar_index - j
                bestT := time[j]
    [bestP, bestBar, bestT]

// Lowest low within one aggregated candle's chart-bar range.
findLowestInCandle(int sBar, int eBar) =>
    float bestP = na
    int bestBar = na
    int bestT = na
    int offA = bar_index - eBar
    int offB = math.min(bar_index - sBar, 4999)
    if offA >= 0 and offA <= offB
        for j = offA to offB
            if na(bestP) or low[j] < bestP
                bestP := low[j]
                bestBar := bar_index - j
                bestT := time[j]
    [bestP, bestBar, bestT]

// Highest high on chart bars from fromBar to the current bar. Ties keep the
// most recent bar. Returns [price, chartBar].
findHighestSince(int fromBar) =>
    float bestP = na
    int bestBar = na
    int maxOff = math.min(bar_index - fromBar, 4999)
    if maxOff >= 0
        for j = 0 to maxOff
            if na(bestP) or high[j] > bestP
                bestP := high[j]
                bestBar := bar_index - j
    [bestP, bestBar]

// Lowest low on chart bars from fromBar to the current bar.
findLowestSince(int fromBar) =>
    float bestP = na
    int bestBar = na
    int maxOff = math.min(bar_index - fromBar, 4999)
    if maxOff >= 0
        for j = 0 to maxOff
            if na(bestP) or low[j] < bestP
                bestP := low[j]
                bestBar := bar_index - j
    [bestP, bestBar]

// ============================================================================
// AOI CONFIRMATION
// ============================================================================

// A swing low was just body-broken on the AOI timeframe. Confirm the supply
// AOI: there must be a swing high before the low (H1) and a higher high after
// it (H2 > H1). AOI band = [low .. H2], spanning from the low to the break.
attemptSupplyAoi(SwingPoint sl) =>
    Aoi result = na
    float h1 = na
    if array.size(swingHighs) > 0
        for i = array.size(swingHighs) - 1 to 0
            SwingPoint sh = array.get(swingHighs, i)
            if sh.seq < sl.seq
                h1 := sh.price
                break
    if not na(h1)
        [h2p, h2b] = findHighestSince(sl.extremeBar)
        if not na(h2p)
            if h2b > sl.extremeBar and h2p > h1
                result := Aoi.new(dir = -1, top = h2p, bottom = sl.price,
                  leftBar = sl.extremeBar, leftTime = sl.extremeTime,
                  confirmBar = bar_index - 1, confirmTime = time[1])
    result

// Mirror: a swing high was just body-broken upward. Demand AOI requires a
// swing low before it (L1) and a lower low after it (L2 < L1).
attemptDemandAoi(SwingPoint sh) =>
    Aoi result = na
    float l1 = na
    if array.size(swingLows) > 0
        for i = array.size(swingLows) - 1 to 0
            SwingPoint sl = array.get(swingLows, i)
            if sl.seq < sh.seq
                l1 := sl.price
                break
    if not na(l1)
        [l2p, l2b] = findLowestSince(sh.extremeBar)
        if not na(l2p)
            if l2b > sh.extremeBar and l2p < l1
                result := Aoi.new(dir = 1, top = sh.price, bottom = l2p,
                  leftBar = sh.extremeBar, leftTime = sh.extremeTime,
                  confirmBar = bar_index - 1, confirmTime = time[1])
    result

// ============================================================================
// ZONE SCANNING
// ============================================================================

// Nested AOIs (one break candle clearing several lows) would rediscover the
// same candle series — skip exact duplicates.
zoneExists(array<Zone> zones, int leftBar, float top, float btm) =>
    bool found = false
    if array.size(zones) > 0
        for i = 0 to array.size(zones) - 1
            Zone z = array.get(zones, i)
            if z.leftBar == leftBar and z.top == top and z.bottom == btm
                found := true
                break
    found

// Replay a freshly created zone's life from the chart bar after its zone-TF
// body break up to the current bar, so zones discovered retrospectively carry
// the correct touched/broken status. (An early series in the up-leg is often
// already broken again by the rally to the higher high — such zones are kept
// but hidden unless Show Broken Zones is on.) Replay is capped at 5000 bars
// back; anything older simply starts its life un-touched.
replayZone(Zone z) =>
    int startOff = math.min(bar_index - z.createdBar - 1, 4999)
    if startOff >= 0
        for j = startOff to 0
            if not z.touched and low[j] <= z.top and high[j] >= z.bottom
                z.touched := true
            bool brokeNow = z.dir == -1
              ? (breakOnWick ? high[j] > z.top : close[j] > z.top)
              : (breakOnWick ? low[j] < z.bottom : close[j] < z.bottom)
            if brokeNow
                z.broken := true
                z.brokenTime := time[j]
                break
    true

// Scan the zone-TF candle history inside a freshly confirmed supply AOI,
// running the structure logic one level down. Zone-TF 3-candle swing lows are
// tracked through the window; whenever the NEAREST one (low #1) is broken by
// a candle BODY closing below it, the inverted-V pattern
// (low #1 → local high → body break) becomes a supply zone spanning
// [low #1 .. local high] — the broken level to the V's vertex, not the
// breaking extreme. Returns the number of zones created.
scanSupplyZones(Aoi aoi) =>
    int created = 0
    int n = array.size(zoneHist.cHist)
    if n > 0
        // Oldest history index still inside the AOI window (eHist is
        // monotonically decreasing with the index, so break on first miss).
        int startIdx = -1
        for i = 0 to n - 1
            if array.get(zoneHist.eHist, i) >= aoi.leftBar
                startIdx := i
            else
                break
        if startIdx >= 0
            float l1Price = na
            int l1Idx = na
            // Walk oldest → newest (index 0 = newest candle)
            for i = startIdx to 0
                // A swing low confirms one candle late: candle i+1 is the
                // middle of the trio (i+2, i+1, i). It replaces the previous
                // nearest structure low. (Candle i can never confirm a swing
                // and break it at the same time — confirmation requires its
                // low to stay above the swing.) The middle candle must be
                // inside the AOI window; its older neighbor may precede it.
                if i + 1 <= startIdx and i + 2 < n
                    float mL = array.get(zoneHist.lHist, i + 1)
                    if mL < array.get(zoneHist.lHist, i + 2) and mL < array.get(zoneHist.lHist, i)
                        l1Price := mL
                        l1Idx := i + 1
                if not na(l1Price)
                    float c = array.get(zoneHist.cHist, i)
                    float l = array.get(zoneHist.lHist, i)
                    if c < l1Price
                        // Body break of the nearest low → zone from low #1 up
                        // to the local high of the inverted V between them
                        float vHigh = na
                        int vIdx = na
                        for k = l1Idx to i
                            float kH = array.get(zoneHist.hHist, k)
                            if na(vHigh) or kH > vHigh
                                vHigh := kH
                                vIdx := k
                        float zTop = vHigh
                        float zBtm = l1Price
                        bool inPrice = zoneScopeInside
                          ? zTop <= aoi.top and zBtm >= aoi.bottom
                          : zTop >= aoi.bottom and zBtm <= aoi.top
                        int zLeftBar = array.get(zoneHist.sHist, vIdx)
                        if inPrice and zTop > zBtm and zTop - zBtm >= minZoneSize and not zoneExists(supplyZones, zLeftBar, zTop, zBtm)
                            Zone z = Zone.new(dir = -1, top = zTop, bottom = zBtm,
                              leftBar = zLeftBar,
                              leftTime = array.get(zoneHist.tHist, vIdx),
                              createdBar = array.get(zoneHist.eHist, i))
                            replayZone(z)
                            array.unshift(supplyZones, z)
                            if array.size(supplyZones) > maxZones
                                array.pop(supplyZones)
                            created += 1
                        l1Price := na
                        l1Idx := na
                    else if invalidateZoneSweep and l < l1Price
                        // Wick-first sweep disqualifies the level
                        l1Price := na
                        l1Idx := na
    created

// Mirror: zone-TF 3-candle swing highs are tracked through the window;
// whenever the NEAREST one (high #1) is broken by a candle BODY closing above
// it, the V pattern (high #1 → local low → body break) becomes a demand zone
// spanning [local low .. high #1] — not the breaking high (high #2).
scanDemandZones(Aoi aoi) =>
    int created = 0
    int n = array.size(zoneHist.cHist)
    if n > 0
        int startIdx = -1
        for i = 0 to n - 1
            if array.get(zoneHist.eHist, i) >= aoi.leftBar
                startIdx := i
            else
                break
        if startIdx >= 0
            float h1Price = na
            int h1Idx = na
            for i = startIdx to 0
                if i + 1 <= startIdx and i + 2 < n
                    float mH = array.get(zoneHist.hHist, i + 1)
                    if mH > array.get(zoneHist.hHist, i + 2) and mH > array.get(zoneHist.hHist, i)
                        h1Price := mH
                        h1Idx := i + 1
                if not na(h1Price)
                    float c = array.get(zoneHist.cHist, i)
                    float h = array.get(zoneHist.hHist, i)
                    if c > h1Price
                        // Body break of the nearest high → zone from the V's
                        // local low up to high #1
                        float vLow = na
                        int vIdx = na
                        for k = h1Idx to i
                            float kL = array.get(zoneHist.lHist, k)
                            if na(vLow) or kL < vLow
                                vLow := kL
                                vIdx := k
                        float zTop = h1Price
                        float zBtm = vLow
                        bool inPrice = zoneScopeInside
                          ? zTop <= aoi.top and zBtm >= aoi.bottom
                          : zTop >= aoi.bottom and zBtm <= aoi.top
                        int zLeftBar = array.get(zoneHist.sHist, vIdx)
                        if inPrice and zTop > zBtm and zTop - zBtm >= minZoneSize and not zoneExists(demandZones, zLeftBar, zTop, zBtm)
                            Zone z = Zone.new(dir = 1, top = zTop, bottom = zBtm,
                              leftBar = zLeftBar,
                              leftTime = array.get(zoneHist.tHist, vIdx),
                              createdBar = array.get(zoneHist.eHist, i))
                            replayZone(z)
                            array.unshift(demandZones, z)
                            if array.size(demandZones) > maxZones
                                array.pop(demandZones)
                            created += 1
                        h1Price := na
                        h1Idx := na
                    else if invalidateZoneSweep and h > h1Price
                        h1Price := na
                        h1Idx := na
    created

// ============================================================================
// ZONE LIFECYCLE (per chart bar)
// ============================================================================

// Touch/break tracking on chart-bar prices. Returns [touchFired, breakFired].
updateZones(array<Zone> zones) =>
    bool tFired = false
    bool bFired = false
    if array.size(zones) > 0
        for i = 0 to array.size(zones) - 1
            Zone z = array.get(zones, i)
            if not z.broken
                if not z.touched and low <= z.top and high >= z.bottom
                    z.touched := true
                    tFired := true
                bool brokeNow = z.dir == -1
                  ? (breakOnWick ? high > z.top : close > z.top)
                  : (breakOnWick ? low < z.bottom : close < z.bottom)
                if brokeNow
                    z.broken := true
                    z.brokenTime := time
                    bFired := true
    [tFired, bFired]

// ============================================================================
// MAIN LOGIC
// ============================================================================

// Aggregate the zone TF BEFORE the AOI TF: when both periods roll over on the
// same chart bar (the usual case), the AOI confirmation scan must already see
// the final zone-TF candle of the completed AOI candle.
bool zoneNewPeriod = timeframe.change(zoneTfRes)
bool aoiNewPeriod = timeframe.change(aoiTfRes)

advanceHist(zoneHist, zoneNewPeriod)
bool pushedAoi = advanceHist(aoiHist, aoiNewPeriod)

if pushedAoi
    // ── Swing detection on the middle of the last three completed candles ──
    // New swing points are registered BEFORE the break/sweep checks so the
    // just-completed candle is evaluated against them immediately.
    if array.size(aoiHist.hHist) >= 3
        float mH = array.get(aoiHist.hHist, 1)
        float mL = array.get(aoiHist.lHist, 1)
        int mSeq = aoiHist.count - 2
        int mSBar = array.get(aoiHist.sHist, 1)
        int mEBar = array.get(aoiHist.eHist, 1)
        if mH > array.get(aoiHist.hHist, 2) and mH > array.get(aoiHist.hHist, 0)
            [p, b, t] = findHighestInCandle(mSBar, mEBar)
            if not na(b)
                array.push(swingHighs, SwingPoint.new(seq = mSeq, price = p, extremeBar = b, extremeTime = t))
                if array.size(swingHighs) > 30
                    array.shift(swingHighs)
        if mL < array.get(aoiHist.lHist, 2) and mL < array.get(aoiHist.lHist, 0)
            [p, b, t] = findLowestInCandle(mSBar, mEBar)
            if not na(b)
                array.push(swingLows, SwingPoint.new(seq = mSeq, price = p, extremeBar = b, extremeTime = t))
                if array.size(swingLows) > 30
                    array.shift(swingLows)

    // ── Check the just-completed AOI candle against tracked swing points ──
    if array.size(aoiHist.cHist) > 0
        float cH = array.get(aoiHist.hHist, 0)
        float cL = array.get(aoiHist.lHist, 0)
        float cC = array.get(aoiHist.cHist, 0)

        // Supply: body close below a tracked swing low confirms (or consumes) it
        if array.size(swingLows) > 0
            for i = array.size(swingLows) - 1 to 0
                SwingPoint sl = array.get(swingLows, i)
                if sl.active
                    if cC < sl.price
                        sl.active := false
                        Aoi newAoi = attemptSupplyAoi(sl)
                        if not na(newAoi)
                            array.unshift(aois, newAoi)
                            if array.size(aois) > maxAois
                                array.pop(aois)
                            supplyAoiFlag := true
                            int created = scanSupplyZones(newAoi)
                            if created > 0
                                supplyZoneCreatedFlag := true
                                Zone newest = array.get(supplyZones, 0)
                                supplyZoneCreatedTop := newest.top
                                supplyZoneCreatedBtm := newest.bottom
                    else if invalidateAoiSweep and cL < sl.price
                        sl.active := false

        // Demand: body close above a tracked swing high
        if array.size(swingHighs) > 0
            for i = array.size(swingHighs) - 1 to 0
                SwingPoint sh = array.get(swingHighs, i)
                if sh.active
                    if cC > sh.price
                        sh.active := false
                        Aoi newAoi = attemptDemandAoi(sh)
                        if not na(newAoi)
                            array.unshift(aois, newAoi)
                            if array.size(aois) > maxAois
                                array.pop(aois)
                            demandAoiFlag := true
                            int created = scanDemandZones(newAoi)
                            if created > 0
                                demandZoneCreatedFlag := true
                                Zone newest = array.get(demandZones, 0)
                                demandZoneCreatedTop := newest.top
                                demandZoneCreatedBtm := newest.bottom
                    else if invalidateAoiSweep and cH > sh.price
                        sh.active := false

// Live touch/break tracking (zones created this bar were already replayed
// through the current bar, so re-checking them here is a no-op)
[sTouch, sBreak] = updateZones(supplyZones)
[dTouch, dBreak] = updateZones(demandZones)
supplyTouchFlag := supplyTouchFlag or sTouch
supplyBreakFlag := supplyBreakFlag or sBreak
demandTouchFlag := demandTouchFlag or dTouch
demandBreakFlag := demandBreakFlag or dBreak

// ============================================================================
// RENDERING — redraw everything on the last bar only (MSM V9 / V11 pattern)
// ============================================================================

renderZones(array<Zone> zones, color fillCol, color borderCol) =>
    if array.size(zones) > 0
        for i = 0 to array.size(zones) - 1
            Zone z = array.get(zones, i)
            if not z.broken or showBrokenZones
                int rightT = z.broken ? z.brokenTime : time
                color fillC = changeColorOnTouched and z.touched ? zoneTouchedColorInput : fillCol
                box.new(z.leftTime, z.top, rightT, z.bottom, xloc = xloc.bar_time,
                  bgcolor = fillC, border_color = borderCol,
                  border_style = z.broken ? line.style_dashed : line.style_solid)
    true

if barstate.islast
    for bx in box.all
        bx.delete()

    if showAois and array.size(aois) > 0
        for i = 0 to array.size(aois) - 1
            Aoi a = array.get(aois, i)
            color col = a.dir == -1 ? aoiSupplyColorInput : aoiDemandColorInput
            box.new(a.leftTime, a.top, a.confirmTime, a.bottom, xloc = xloc.bar_time,
              bgcolor = color.new(col, aoiFillTransp), border_color = col,
              border_style = line.style_dashed)

    if showZones
        renderZones(supplyZones, supplyZoneColorInput, supplyZoneBorderInput)
        renderZones(demandZones, demandZoneColorInput, demandZoneBorderInput)

// ============================================================================
// ALERTS
// ============================================================================

plot(supplyZoneCreatedTop, title = "Supply Zone Created Top",    display = display.none)
plot(supplyZoneCreatedBtm, title = "Supply Zone Created Bottom", display = display.none)
plot(demandZoneCreatedTop, title = "Demand Zone Created Top",    display = display.none)
plot(demandZoneCreatedBtm, title = "Demand Zone Created Bottom", display = display.none)

alertcondition(supplyAoiFlag,         title = "Supply AOI Confirmed", message = "Supply AOI confirmed on {{ticker}}")
alertcondition(demandAoiFlag,         title = "Demand AOI Confirmed", message = "Demand AOI confirmed on {{ticker}}")
alertcondition(supplyZoneCreatedFlag, title = "Supply Zone Created",  message = 'Supply Zone created on {{ticker}}, Top: {{plot("Supply Zone Created Top")}}, Bottom: {{plot("Supply Zone Created Bottom")}}')
alertcondition(demandZoneCreatedFlag, title = "Demand Zone Created",  message = 'Demand Zone created on {{ticker}}, Top: {{plot("Demand Zone Created Top")}}, Bottom: {{plot("Demand Zone Created Bottom")}}')
alertcondition(supplyTouchFlag,       title = "Supply Zone Touched",  message = "Price touched a Supply Zone on {{ticker}}")
alertcondition(demandTouchFlag,       title = "Demand Zone Touched",  message = "Price touched a Demand Zone on {{ticker}}")
alertcondition(supplyBreakFlag,       title = "Supply Zone Broken",   message = "A Supply Zone was fully broken on {{ticker}}")
alertcondition(demandBreakFlag,       title = "Demand Zone Broken",   message = "A Demand Zone was fully broken on {{ticker}}")

// Reset all alert flags at end of bar
supplyAoiFlag := false
demandAoiFlag := false
supplyZoneCreatedFlag := false
demandZoneCreatedFlag := false
supplyTouchFlag := false
demandTouchFlag := false
supplyBreakFlag := false
demandBreakFlag := false
supplyZoneCreatedTop := na
supplyZoneCreatedBtm := na
demandZoneCreatedTop := na
demandZoneCreatedBtm := na
