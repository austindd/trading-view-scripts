//@version=5
indicator("EMA Trend Cloud MTF V2 [SB]", "ETC MTF V2 [SB]", overlay=true)

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================
formatTF(string tf) =>
    string resolved = tf == "" ? timeframe.period : tf
    if str.endswith(resolved, "S") or str.endswith(resolved, "D") or str.endswith(resolved, "W") or str.endswith(resolved, "M")
        resolved
    else
        float mins = str.tonumber(resolved)
        if not na(mins) and mins >= 60 and int(mins) % 60 == 0
            str.tostring(int(mins / 60)) + "H"
        else
            resolved + "m"

// Returns a fill color with transparency modulated by width percentile.
// pct=0 → most transparent (95), pct=100 → most opaque (55).
// Falls back to baseColor unchanged when modulation is disabled or pct is na.
f_fillColor(color baseColor, float pct, bool modulate) =>
    if modulate and not na(pct)
        int transp = int(math.max(55, math.min(95, 95 - pct * 0.4)))
        color.new(baseColor, transp)
    else
        baseColor

// Formats the width metric value for table display.
f_widthDisplay(float pct, float pctOfAvg, string metricType) =>
    string result = "-"
    if metricType == "Percentile"
        if not na(pct)
            result := str.tostring(math.round(pct)) + "%"
    else  // "% of Avg"
        if not na(pctOfAvg)
            result := str.tostring(math.round(pctOfAvg)) + "%"
    result

// ============================================================================
// EMA SETTINGS
// ============================================================================
fastLen      = input.int(9,  "Fast EMA Length", minval=1, group="EMA Settings")
slowLen      = input.int(21, "Slow EMA Length", minval=1, group="EMA Settings")
useRealtime  = input.bool(false, "Use Realtime HTF Data", tooltip="When enabled, HTF clouds update with developing candle data. When disabled, HTF clouds only update on candle close (non-repainting).", group="EMA Settings")

// ============================================================================
// CLOUD WIDTH SETTINGS
// ============================================================================
widthLookback   = input.int(1000, "Width Lookback (HTF candles)", minval=50, maxval=2000, tooltip="Number of closed HTF candles used to build the width history. Each timeframe maintains its own independent history.", group="Cloud Width")
showWidthCol    = input.bool(true, "Show Width Column in Table", group="Cloud Width")
widthMetricType = input.string("Percentile", "Width Metric", options=["Percentile", "% of Avg"], tooltip="Percentile: 0–100 position within the historical min–max width range. Near 0 = historically narrow (squeeze). Near 100 = historically wide (expanded trend).\n% of Avg: current width as a percentage of the historical average width. 100% = at average, 200% = twice the average.", group="Cloud Width")
modulateOpacity = input.bool(false, "Modulate Cloud Opacity by Width Percentile", tooltip="When enabled, clouds near the historical maximum width appear more opaque; historically narrow clouds appear more transparent.", group="Cloud Width")

// ============================================================================
// TIMEFRAME 1 SETTINGS
// ============================================================================
tf1Enabled       = input.bool(true,  "Show TF1 Cloud",              group="Timeframe 1")
tf1InStatus      = input.bool(true,  "Include TF1 in Trend Status", group="Timeframe 1")
tf1UseMultiplier = input.bool(false, "Use Chart TF Multiplier",     tooltip="When enabled, uses a multiple of the chart timeframe instead of the fixed timeframe setting.", group="Timeframe 1")
tf1Multiplier    = input.float(1.0,  "Chart TF Multiplier",         minval=1.0, step=0.5, tooltip="Multiplier applied to the chart timeframe. E.g. 2.0 on a 5m chart = 10m.", group="Timeframe 1")
tf1Timeframe     = input.timeframe("",  "TF1 Timeframe",            group="Timeframe 1")
tf1BullColor     = input.color(color.new(color.green,  95), "TF1 Bull Cloud", group="Timeframe 1")
tf1BearColor     = input.color(color.new(color.red,    95), "TF1 Bear Cloud", group="Timeframe 1")

// ============================================================================
// TIMEFRAME 2 SETTINGS
// ============================================================================
tf2Enabled       = input.bool(true,  "Show TF2 Cloud",              group="Timeframe 2")
tf2InStatus      = input.bool(true,  "Include TF2 in Trend Status", group="Timeframe 2")
tf2UseMultiplier = input.bool(false, "Use Chart TF Multiplier",     tooltip="When enabled, uses a multiple of the chart timeframe instead of the fixed timeframe setting.", group="Timeframe 2")
tf2Multiplier    = input.float(1.0,  "Chart TF Multiplier",         minval=1.0, step=0.5, tooltip="Multiplier applied to the chart timeframe. E.g. 2.0 on a 5m chart = 10m.", group="Timeframe 2")
tf2Timeframe     = input.timeframe("15", "TF2 Timeframe",           group="Timeframe 2")
tf2BullColor     = input.color(color.new(color.blue,   95), "TF2 Bull Cloud", group="Timeframe 2")
tf2BearColor     = input.color(color.new(color.orange, 95), "TF2 Bear Cloud", group="Timeframe 2")

// ============================================================================
// TIMEFRAME 3 SETTINGS
// ============================================================================
tf3Enabled       = input.bool(true,  "Show TF3 Cloud",              group="Timeframe 3")
tf3InStatus      = input.bool(true,  "Include TF3 in Trend Status", group="Timeframe 3")
tf3UseMultiplier = input.bool(false, "Use Chart TF Multiplier",     tooltip="When enabled, uses a multiple of the chart timeframe instead of the fixed timeframe setting.", group="Timeframe 3")
tf3Multiplier    = input.float(1.0,  "Chart TF Multiplier",         minval=1.0, step=0.5, tooltip="Multiplier applied to the chart timeframe. E.g. 2.0 on a 5m chart = 10m.", group="Timeframe 3")
tf3Timeframe     = input.timeframe("60", "TF3 Timeframe",           group="Timeframe 3")
tf3BullColor     = input.color(color.new(color.teal,   95), "TF3 Bull Cloud", group="Timeframe 3")
tf3BearColor     = input.color(color.new(color.purple, 95), "TF3 Bear Cloud", group="Timeframe 3")

// ============================================================================
// TIMEFRAME 4 SETTINGS
// ============================================================================
tf4Enabled       = input.bool(true,  "Show TF4 Cloud",              group="Timeframe 4")
tf4InStatus      = input.bool(true,  "Include TF4 in Trend Status", group="Timeframe 4")
tf4UseMultiplier = input.bool(false, "Use Chart TF Multiplier",     tooltip="When enabled, uses a multiple of the chart timeframe instead of the fixed timeframe setting.", group="Timeframe 4")
tf4Multiplier    = input.float(1.0,  "Chart TF Multiplier",         minval=1.0, step=0.5, tooltip="Multiplier applied to the chart timeframe. E.g. 2.0 on a 5m chart = 10m.", group="Timeframe 4")
tf4Timeframe     = input.timeframe("D", "TF4 Timeframe",            group="Timeframe 4")
tf4BullColor     = input.color(color.new(color.lime,   95), "TF4 Bull Cloud", group="Timeframe 4")
tf4BearColor     = input.color(color.new(color.maroon, 95), "TF4 Bear Cloud", group="Timeframe 4")

// ============================================================================
// TIMEFRAME 5 SETTINGS
// ============================================================================
tf5Enabled       = input.bool(false, "Show TF5 Cloud",              group="Timeframe 5")
tf5InStatus      = input.bool(false, "Include TF5 in Trend Status", group="Timeframe 5")
tf5UseMultiplier = input.bool(false, "Use Chart TF Multiplier",     tooltip="When enabled, uses a multiple of the chart timeframe instead of the fixed timeframe setting.", group="Timeframe 5")
tf5Multiplier    = input.float(1.0,  "Chart TF Multiplier",         minval=1.0, step=0.5, tooltip="Multiplier applied to the chart timeframe. E.g. 2.0 on a 5m chart = 10m.", group="Timeframe 5")
tf5Timeframe     = input.timeframe("W", "TF5 Timeframe",            group="Timeframe 5")
tf5BullColor     = input.color(color.new(color.aqua,    95), "TF5 Bull Cloud", group="Timeframe 5")
tf5BearColor     = input.color(color.new(color.fuchsia, 95), "TF5 Bear Cloud", group="Timeframe 5")

// ============================================================================
// STATUS TABLE SETTINGS
// ============================================================================
showTable            = input.bool(true,  "Show Trend Status Table", group="Status Table")
condensedTable       = input.bool(false, "Condensed Mode",          tooltip="When enabled, only shows the aggregated status row without individual timeframe rows.", group="Status Table")
requireSlope         = input.bool(true,  "Require EMA Slope",       tooltip="When enabled, Bull/Bear requires both EMAs sloping in the trend direction. When disabled, only checks fast vs slow EMA position.", group="Status Table")
showBgColor          = input.bool(false, "Show Background Colors",  group="Status Table")
bgBullishExpansion   = input.color(color.new(color.green, 85), "Bullish Expansion BG",   group="Status Table")
bgBearishExpansion   = input.color(color.new(color.red,   85), "Bearish Expansion BG",   group="Status Table")
bgBullishContraction = input.color(color.new(color.green, 92), "Bullish Contraction BG", group="Status Table")
bgBearishContraction = input.color(color.new(color.red,   92), "Bearish Contraction BG", group="Status Table")
bgBullish            = input.color(color.new(color.green, 88), "Bullish BG",             group="Status Table")
bgBearish            = input.color(color.new(color.red,   88), "Bearish BG",             group="Status Table")
bgNeutralContraction = input.color(color.new(color.gray,  90), "Neutral Contraction BG", group="Status Table")

// ============================================================================
// COMPUTE FINAL TIMEFRAME STRINGS
// ============================================================================
// Computed inline (not via function) to preserve "simple string" qualifier
// required by request.security(). User-defined functions return "series".
string _chartTFSuffix = timeframe.isseconds ? "S" : timeframe.isminutes ? "" : timeframe.isdaily ? "D" : timeframe.isweekly ? "W" : "M"
string tf1TF = tf1UseMultiplier ? str.tostring(math.round(timeframe.multiplier * tf1Multiplier)) + _chartTFSuffix : tf1Timeframe
string tf2TF = tf2UseMultiplier ? str.tostring(math.round(timeframe.multiplier * tf2Multiplier)) + _chartTFSuffix : tf2Timeframe
string tf3TF = tf3UseMultiplier ? str.tostring(math.round(timeframe.multiplier * tf3Multiplier)) + _chartTFSuffix : tf3Timeframe
string tf4TF = tf4UseMultiplier ? str.tostring(math.round(timeframe.multiplier * tf4Multiplier)) + _chartTFSuffix : tf4Timeframe
string tf5TF = tf5UseMultiplier ? str.tostring(math.round(timeframe.multiplier * tf5Multiplier)) + _chartTFSuffix : tf5Timeframe

// ============================================================================
// EMA CALCULATIONS
// ============================================================================
[tf1FastRaw, tf1SlowRaw, tf1FastPrevRaw, tf1SlowPrevRaw, tf1Time] = request.security(syminfo.tickerid, tf1TF, [ta.ema(close, fastLen), ta.ema(close, slowLen), ta.ema(close, fastLen)[1], ta.ema(close, slowLen)[1], time])
[tf2FastRaw, tf2SlowRaw, tf2FastPrevRaw, tf2SlowPrevRaw, tf2Time] = request.security(syminfo.tickerid, tf2TF, [ta.ema(close, fastLen), ta.ema(close, slowLen), ta.ema(close, fastLen)[1], ta.ema(close, slowLen)[1], time])
[tf3FastRaw, tf3SlowRaw, tf3FastPrevRaw, tf3SlowPrevRaw, tf3Time] = request.security(syminfo.tickerid, tf3TF, [ta.ema(close, fastLen), ta.ema(close, slowLen), ta.ema(close, fastLen)[1], ta.ema(close, slowLen)[1], time])
[tf4FastRaw, tf4SlowRaw, tf4FastPrevRaw, tf4SlowPrevRaw, tf4Time] = request.security(syminfo.tickerid, tf4TF, [ta.ema(close, fastLen), ta.ema(close, slowLen), ta.ema(close, fastLen)[1], ta.ema(close, slowLen)[1], time])
[tf5FastRaw, tf5SlowRaw, tf5FastPrevRaw, tf5SlowPrevRaw, tf5Time] = request.security(syminfo.tickerid, tf5TF, [ta.ema(close, fastLen), ta.ema(close, slowLen), ta.ema(close, fastLen)[1], ta.ema(close, slowLen)[1], time])

// Detect new HTF candle per timeframe
tf1NewCandle = ta.change(tf1Time) != 0
tf2NewCandle = ta.change(tf2Time) != 0
tf3NewCandle = ta.change(tf3Time) != 0
tf4NewCandle = ta.change(tf4Time) != 0
tf5NewCandle = ta.change(tf5Time) != 0

// Confirmed-only EMA storage (updated only on HTF candle close)
var float tf1FastConf = na, var float tf1SlowConf = na, var float tf1FastPrevConf = na, var float tf1SlowPrevConf = na
var float tf2FastConf = na, var float tf2SlowConf = na, var float tf2FastPrevConf = na, var float tf2SlowPrevConf = na
var float tf3FastConf = na, var float tf3SlowConf = na, var float tf3FastPrevConf = na, var float tf3SlowPrevConf = na
var float tf4FastConf = na, var float tf4SlowConf = na, var float tf4FastPrevConf = na, var float tf4SlowPrevConf = na
var float tf5FastConf = na, var float tf5SlowConf = na, var float tf5FastPrevConf = na, var float tf5SlowPrevConf = na

// ============================================================================
// WIDTH HISTORY ARRAYS
// Width is tracked from closed HTF candles regardless of the useRealtime setting,
// so the historical baseline is always built from confirmed data.
// ============================================================================
var float[] tf1WidthHist = array.new_float(0)
var float[] tf2WidthHist = array.new_float(0)
var float[] tf3WidthHist = array.new_float(0)
var float[] tf4WidthHist = array.new_float(0)
var float[] tf5WidthHist = array.new_float(0)

if tf1NewCandle
    tf1FastConf     := tf1FastRaw
    tf1SlowConf     := tf1SlowRaw
    tf1FastPrevConf := tf1FastPrevRaw
    tf1SlowPrevConf := tf1SlowPrevRaw
    float _w = math.abs(tf1FastRaw - tf1SlowRaw)
    if not na(_w)
        array.unshift(tf1WidthHist, _w)
        if array.size(tf1WidthHist) > widthLookback
            array.pop(tf1WidthHist)

if tf2NewCandle
    tf2FastConf     := tf2FastRaw
    tf2SlowConf     := tf2SlowRaw
    tf2FastPrevConf := tf2FastPrevRaw
    tf2SlowPrevConf := tf2SlowPrevRaw
    float _w = math.abs(tf2FastRaw - tf2SlowRaw)
    if not na(_w)
        array.unshift(tf2WidthHist, _w)
        if array.size(tf2WidthHist) > widthLookback
            array.pop(tf2WidthHist)

if tf3NewCandle
    tf3FastConf     := tf3FastRaw
    tf3SlowConf     := tf3SlowRaw
    tf3FastPrevConf := tf3FastPrevRaw
    tf3SlowPrevConf := tf3SlowPrevRaw
    float _w = math.abs(tf3FastRaw - tf3SlowRaw)
    if not na(_w)
        array.unshift(tf3WidthHist, _w)
        if array.size(tf3WidthHist) > widthLookback
            array.pop(tf3WidthHist)

if tf4NewCandle
    tf4FastConf     := tf4FastRaw
    tf4SlowConf     := tf4SlowRaw
    tf4FastPrevConf := tf4FastPrevRaw
    tf4SlowPrevConf := tf4SlowPrevRaw
    float _w = math.abs(tf4FastRaw - tf4SlowRaw)
    if not na(_w)
        array.unshift(tf4WidthHist, _w)
        if array.size(tf4WidthHist) > widthLookback
            array.pop(tf4WidthHist)

if tf5NewCandle
    tf5FastConf     := tf5FastRaw
    tf5SlowConf     := tf5SlowRaw
    tf5FastPrevConf := tf5FastPrevRaw
    tf5SlowPrevConf := tf5SlowPrevRaw
    float _w = math.abs(tf5FastRaw - tf5SlowRaw)
    if not na(_w)
        array.unshift(tf5WidthHist, _w)
        if array.size(tf5WidthHist) > widthLookback
            array.pop(tf5WidthHist)

// Select: realtime uses developing data, confirmed waits for HTF candle close
float tf1Fast     = useRealtime ? tf1FastRaw     : tf1FastConf
float tf1Slow     = useRealtime ? tf1SlowRaw     : tf1SlowConf
float tf1FastPrev = useRealtime ? tf1FastPrevRaw : tf1FastPrevConf
float tf1SlowPrev = useRealtime ? tf1SlowPrevRaw : tf1SlowPrevConf
float tf2Fast     = useRealtime ? tf2FastRaw     : tf2FastConf
float tf2Slow     = useRealtime ? tf2SlowRaw     : tf2SlowConf
float tf2FastPrev = useRealtime ? tf2FastPrevRaw : tf2FastPrevConf
float tf2SlowPrev = useRealtime ? tf2SlowPrevRaw : tf2SlowPrevConf
float tf3Fast     = useRealtime ? tf3FastRaw     : tf3FastConf
float tf3Slow     = useRealtime ? tf3SlowRaw     : tf3SlowConf
float tf3FastPrev = useRealtime ? tf3FastPrevRaw : tf3FastPrevConf
float tf3SlowPrev = useRealtime ? tf3SlowPrevRaw : tf3SlowPrevConf
float tf4Fast     = useRealtime ? tf4FastRaw     : tf4FastConf
float tf4Slow     = useRealtime ? tf4SlowRaw     : tf4SlowConf
float tf4FastPrev = useRealtime ? tf4FastPrevRaw : tf4FastPrevConf
float tf4SlowPrev = useRealtime ? tf4SlowPrevRaw : tf4SlowPrevConf
float tf5Fast     = useRealtime ? tf5FastRaw     : tf5FastConf
float tf5Slow     = useRealtime ? tf5SlowRaw     : tf5SlowConf
float tf5FastPrev = useRealtime ? tf5FastPrevRaw : tf5FastPrevConf
float tf5SlowPrev = useRealtime ? tf5SlowPrevRaw : tf5SlowPrevConf

// ============================================================================
// WIDTH METRICS
// Percentile: where current width sits in the [min, max] range of the history.
//   0% = narrowest ever seen, 100% = widest ever seen.
// % of Avg: current width divided by historical average, as a percentage.
//   100% = at the average, 200% = twice as wide as average.
// Requires at least 2 data points in history to compute.
// ============================================================================
float tf1CurWidth  = math.abs(tf1Fast - tf1Slow)
float tf1WidthMin  = array.size(tf1WidthHist) >= 2 ? array.min(tf1WidthHist) : na
float tf1WidthMax  = array.size(tf1WidthHist) >= 2 ? array.max(tf1WidthHist) : na
float tf1WidthAvg  = array.size(tf1WidthHist) >= 2 ? array.avg(tf1WidthHist) : na
float tf1WidthPct  = (not na(tf1WidthMin) and not na(tf1WidthMax) and tf1WidthMax != tf1WidthMin) ? (tf1CurWidth - tf1WidthMin) / (tf1WidthMax - tf1WidthMin) * 100 : na
float tf1WidthPctAvg = (not na(tf1WidthAvg) and tf1WidthAvg > 0) ? tf1CurWidth / tf1WidthAvg * 100 : na

float tf2CurWidth  = math.abs(tf2Fast - tf2Slow)
float tf2WidthMin  = array.size(tf2WidthHist) >= 2 ? array.min(tf2WidthHist) : na
float tf2WidthMax  = array.size(tf2WidthHist) >= 2 ? array.max(tf2WidthHist) : na
float tf2WidthAvg  = array.size(tf2WidthHist) >= 2 ? array.avg(tf2WidthHist) : na
float tf2WidthPct  = (not na(tf2WidthMin) and not na(tf2WidthMax) and tf2WidthMax != tf2WidthMin) ? (tf2CurWidth - tf2WidthMin) / (tf2WidthMax - tf2WidthMin) * 100 : na
float tf2WidthPctAvg = (not na(tf2WidthAvg) and tf2WidthAvg > 0) ? tf2CurWidth / tf2WidthAvg * 100 : na

float tf3CurWidth  = math.abs(tf3Fast - tf3Slow)
float tf3WidthMin  = array.size(tf3WidthHist) >= 2 ? array.min(tf3WidthHist) : na
float tf3WidthMax  = array.size(tf3WidthHist) >= 2 ? array.max(tf3WidthHist) : na
float tf3WidthAvg  = array.size(tf3WidthHist) >= 2 ? array.avg(tf3WidthHist) : na
float tf3WidthPct  = (not na(tf3WidthMin) and not na(tf3WidthMax) and tf3WidthMax != tf3WidthMin) ? (tf3CurWidth - tf3WidthMin) / (tf3WidthMax - tf3WidthMin) * 100 : na
float tf3WidthPctAvg = (not na(tf3WidthAvg) and tf3WidthAvg > 0) ? tf3CurWidth / tf3WidthAvg * 100 : na

float tf4CurWidth  = math.abs(tf4Fast - tf4Slow)
float tf4WidthMin  = array.size(tf4WidthHist) >= 2 ? array.min(tf4WidthHist) : na
float tf4WidthMax  = array.size(tf4WidthHist) >= 2 ? array.max(tf4WidthHist) : na
float tf4WidthAvg  = array.size(tf4WidthHist) >= 2 ? array.avg(tf4WidthHist) : na
float tf4WidthPct  = (not na(tf4WidthMin) and not na(tf4WidthMax) and tf4WidthMax != tf4WidthMin) ? (tf4CurWidth - tf4WidthMin) / (tf4WidthMax - tf4WidthMin) * 100 : na
float tf4WidthPctAvg = (not na(tf4WidthAvg) and tf4WidthAvg > 0) ? tf4CurWidth / tf4WidthAvg * 100 : na

float tf5CurWidth  = math.abs(tf5Fast - tf5Slow)
float tf5WidthMin  = array.size(tf5WidthHist) >= 2 ? array.min(tf5WidthHist) : na
float tf5WidthMax  = array.size(tf5WidthHist) >= 2 ? array.max(tf5WidthHist) : na
float tf5WidthAvg  = array.size(tf5WidthHist) >= 2 ? array.avg(tf5WidthHist) : na
float tf5WidthPct  = (not na(tf5WidthMin) and not na(tf5WidthMax) and tf5WidthMax != tf5WidthMin) ? (tf5CurWidth - tf5WidthMin) / (tf5WidthMax - tf5WidthMin) * 100 : na
float tf5WidthPctAvg = (not na(tf5WidthAvg) and tf5WidthAvg > 0) ? tf5CurWidth / tf5WidthAvg * 100 : na

// ============================================================================
// CLOUD STATE
// ============================================================================
tf1IsBull = tf1Fast > tf1Slow
tf2IsBull = tf2Fast > tf2Slow
tf3IsBull = tf3Fast > tf3Slow
tf4IsBull = tf4Fast > tf4Slow
tf5IsBull = tf5Fast > tf5Slow

// ============================================================================
// FILL COLORS (with optional width-percentile opacity modulation)
// ============================================================================
color tf1FillColor = f_fillColor(tf1IsBull ? tf1BullColor : tf1BearColor, tf1WidthPct, modulateOpacity)
color tf2FillColor = f_fillColor(tf2IsBull ? tf2BullColor : tf2BearColor, tf2WidthPct, modulateOpacity)
color tf3FillColor = f_fillColor(tf3IsBull ? tf3BullColor : tf3BearColor, tf3WidthPct, modulateOpacity)
color tf4FillColor = f_fillColor(tf4IsBull ? tf4BullColor : tf4BearColor, tf4WidthPct, modulateOpacity)
color tf5FillColor = f_fillColor(tf5IsBull ? tf5BullColor : tf5BearColor, tf5WidthPct, modulateOpacity)

// ============================================================================
// PLOTS & FILLS
// ============================================================================
tf1FastPlot = plot(tf1Enabled ? tf1Fast : na, "TF1 Fast EMA", color=tf1IsBull ? color.new(tf1BullColor, 30) : color.new(tf1BearColor, 30), linewidth=1)
tf1SlowPlot = plot(tf1Enabled ? tf1Slow : na, "TF1 Slow EMA", color=tf1IsBull ? color.new(tf1BullColor, 30) : color.new(tf1BearColor, 30), linewidth=1)
fill(tf1FastPlot, tf1SlowPlot, color=tf1FillColor, title="TF1 Cloud")

tf2FastPlot = plot(tf2Enabled ? tf2Fast : na, "TF2 Fast EMA", color=tf2IsBull ? color.new(tf2BullColor, 30) : color.new(tf2BearColor, 30), linewidth=1)
tf2SlowPlot = plot(tf2Enabled ? tf2Slow : na, "TF2 Slow EMA", color=tf2IsBull ? color.new(tf2BullColor, 30) : color.new(tf2BearColor, 30), linewidth=1)
fill(tf2FastPlot, tf2SlowPlot, color=tf2FillColor, title="TF2 Cloud")

tf3FastPlot = plot(tf3Enabled ? tf3Fast : na, "TF3 Fast EMA", color=tf3IsBull ? color.new(tf3BullColor, 30) : color.new(tf3BearColor, 30), linewidth=1)
tf3SlowPlot = plot(tf3Enabled ? tf3Slow : na, "TF3 Slow EMA", color=tf3IsBull ? color.new(tf3BullColor, 30) : color.new(tf3BearColor, 30), linewidth=1)
fill(tf3FastPlot, tf3SlowPlot, color=tf3FillColor, title="TF3 Cloud")

tf4FastPlot = plot(tf4Enabled ? tf4Fast : na, "TF4 Fast EMA", color=tf4IsBull ? color.new(tf4BullColor, 30) : color.new(tf4BearColor, 30), linewidth=1)
tf4SlowPlot = plot(tf4Enabled ? tf4Slow : na, "TF4 Slow EMA", color=tf4IsBull ? color.new(tf4BullColor, 30) : color.new(tf4BearColor, 30), linewidth=1)
fill(tf4FastPlot, tf4SlowPlot, color=tf4FillColor, title="TF4 Cloud")

tf5FastPlot = plot(tf5Enabled ? tf5Fast : na, "TF5 Fast EMA", color=tf5IsBull ? color.new(tf5BullColor, 30) : color.new(tf5BearColor, 30), linewidth=1)
tf5SlowPlot = plot(tf5Enabled ? tf5Slow : na, "TF5 Slow EMA", color=tf5IsBull ? color.new(tf5BullColor, 30) : color.new(tf5BearColor, 30), linewidth=1)
fill(tf5FastPlot, tf5SlowPlot, color=tf5FillColor, title="TF5 Cloud")

// ============================================================================
// ALIGNMENT CHECK
// ============================================================================
tf1SlopeUp   = tf1Fast > tf1FastPrev and tf1Slow > tf1SlowPrev
tf1SlopeDown = tf1Fast < tf1FastPrev and tf1Slow < tf1SlowPrev
tf1Bull      = tf1Fast > tf1Slow and (not requireSlope or tf1SlopeUp)
tf1Bear      = tf1Fast < tf1Slow and (not requireSlope or tf1SlopeDown)

tf2SlopeUp   = tf2Fast > tf2FastPrev and tf2Slow > tf2SlowPrev
tf2SlopeDown = tf2Fast < tf2FastPrev and tf2Slow < tf2SlowPrev
tf2Bull      = tf2Fast > tf2Slow and (not requireSlope or tf2SlopeUp)
tf2Bear      = tf2Fast < tf2Slow and (not requireSlope or tf2SlopeDown)

tf3SlopeUp   = tf3Fast > tf3FastPrev and tf3Slow > tf3SlowPrev
tf3SlopeDown = tf3Fast < tf3FastPrev and tf3Slow < tf3SlowPrev
tf3Bull      = tf3Fast > tf3Slow and (not requireSlope or tf3SlopeUp)
tf3Bear      = tf3Fast < tf3Slow and (not requireSlope or tf3SlopeDown)

tf4SlopeUp   = tf4Fast > tf4FastPrev and tf4Slow > tf4SlowPrev
tf4SlopeDown = tf4Fast < tf4FastPrev and tf4Slow < tf4SlowPrev
tf4Bull      = tf4Fast > tf4Slow and (not requireSlope or tf4SlopeUp)
tf4Bear      = tf4Fast < tf4Slow and (not requireSlope or tf4SlopeDown)

tf5SlopeUp   = tf5Fast > tf5FastPrev and tf5Slow > tf5SlowPrev
tf5SlopeDown = tf5Fast < tf5FastPrev and tf5Slow < tf5SlowPrev
tf5Bull      = tf5Fast > tf5Slow and (not requireSlope or tf5SlopeUp)
tf5Bear      = tf5Fast < tf5Slow and (not requireSlope or tf5SlopeDown)

bool anyInStatus = tf1InStatus or tf2InStatus or tf3InStatus or tf4InStatus or tf5InStatus
bool allBull     = anyInStatus and (not tf1InStatus or tf1Bull) and (not tf2InStatus or tf2Bull) and (not tf3InStatus or tf3Bull) and (not tf4InStatus or tf4Bull) and (not tf5InStatus or tf5Bull)
bool allBear     = anyInStatus and (not tf1InStatus or tf1Bear) and (not tf2InStatus or tf2Bear) and (not tf3InStatus or tf3Bear) and (not tf4InStatus or tf4Bear) and (not tf5InStatus or tf5Bear)

bool allBullPos = anyInStatus and (not tf1InStatus or tf1Fast > tf1Slow) and (not tf2InStatus or tf2Fast > tf2Slow) and (not tf3InStatus or tf3Fast > tf3Slow) and (not tf4InStatus or tf4Fast > tf4Slow) and (not tf5InStatus or tf5Fast > tf5Slow)
bool allBearPos = anyInStatus and (not tf1InStatus or tf1Fast < tf1Slow) and (not tf2InStatus or tf2Fast < tf2Slow) and (not tf3InStatus or tf3Fast < tf3Slow) and (not tf4InStatus or tf4Fast < tf4Slow) and (not tf5InStatus or tf5Fast < tf5Slow)

// Cloud expanding
tf1BullExpanding = (tf1Fast - tf1Slow) > (tf1FastPrev - tf1SlowPrev)
tf1BearExpanding = (tf1Slow - tf1Fast) > (tf1SlowPrev - tf1FastPrev)
tf2BullExpanding = (tf2Fast - tf2Slow) > (tf2FastPrev - tf2SlowPrev)
tf2BearExpanding = (tf2Slow - tf2Fast) > (tf2SlowPrev - tf2FastPrev)
tf3BullExpanding = (tf3Fast - tf3Slow) > (tf3FastPrev - tf3SlowPrev)
tf3BearExpanding = (tf3Slow - tf3Fast) > (tf3SlowPrev - tf3FastPrev)
tf4BullExpanding = (tf4Fast - tf4Slow) > (tf4FastPrev - tf4SlowPrev)
tf4BearExpanding = (tf4Slow - tf4Fast) > (tf4SlowPrev - tf4FastPrev)
tf5BullExpanding = (tf5Fast - tf5Slow) > (tf5FastPrev - tf5SlowPrev)
tf5BearExpanding = (tf5Slow - tf5Fast) > (tf5SlowPrev - tf5FastPrev)

bool allBullExpanding = allBull and (not tf1InStatus or tf1BullExpanding) and (not tf2InStatus or tf2BullExpanding) and (not tf3InStatus or tf3BullExpanding) and (not tf4InStatus or tf4BullExpanding) and (not tf5InStatus or tf5BullExpanding)
bool allBearExpanding = allBear and (not tf1InStatus or tf1BearExpanding) and (not tf2InStatus or tf2BearExpanding) and (not tf3InStatus or tf3BearExpanding) and (not tf4InStatus or tf4BearExpanding) and (not tf5InStatus or tf5BearExpanding)

// Cloud contracting
tf1BullContracting = (tf1Fast - tf1Slow) < (tf1FastPrev - tf1SlowPrev)
tf1BearContracting = (tf1Slow - tf1Fast) < (tf1SlowPrev - tf1FastPrev)
tf2BullContracting = (tf2Fast - tf2Slow) < (tf2FastPrev - tf2SlowPrev)
tf2BearContracting = (tf2Slow - tf2Fast) < (tf2SlowPrev - tf2FastPrev)
tf3BullContracting = (tf3Fast - tf3Slow) < (tf3FastPrev - tf3SlowPrev)
tf3BearContracting = (tf3Slow - tf3Fast) < (tf3SlowPrev - tf3FastPrev)
tf4BullContracting = (tf4Fast - tf4Slow) < (tf4FastPrev - tf4SlowPrev)
tf4BearContracting = (tf4Slow - tf4Fast) < (tf4SlowPrev - tf4FastPrev)
tf5BullContracting = (tf5Fast - tf5Slow) < (tf5FastPrev - tf5SlowPrev)
tf5BearContracting = (tf5Slow - tf5Fast) < (tf5SlowPrev - tf5FastPrev)

bool allBullContracting = allBull and (not tf1InStatus or tf1BullContracting) and (not tf2InStatus or tf2BullContracting) and (not tf3InStatus or tf3BullContracting) and (not tf4InStatus or tf4BullContracting) and (not tf5InStatus or tf5BullContracting)
bool allBearContracting = allBear and (not tf1InStatus or tf1BearContracting) and (not tf2InStatus or tf2BearContracting) and (not tf3InStatus or tf3BearContracting) and (not tf4InStatus or tf4BearContracting) and (not tf5InStatus or tf5BearContracting)

// Neutral contraction
tf1Contracting = tf1BullContracting or tf1BearContracting
tf2Contracting = tf2BullContracting or tf2BearContracting
tf3Contracting = tf3BullContracting or tf3BearContracting
tf4Contracting = tf4BullContracting or tf4BearContracting
tf5Contracting = tf5BullContracting or tf5BearContracting

bool allContracting     = anyInStatus and (not tf1InStatus or tf1Contracting) and (not tf2InStatus or tf2Contracting) and (not tf3InStatus or tf3Contracting) and (not tf4InStatus or tf4Contracting) and (not tf5InStatus or tf5Contracting)
bool neutralContraction = allContracting and not allBullPos and not allBearPos

string alignment = allBullExpanding ? "Bullish Expansion" : allBearExpanding ? "Bearish Expansion" : allBullContracting ? "Bullish Contraction" : allBearContracting ? "Bearish Contraction" : allBull ? "Bullish" : allBear ? "Bearish" : allBullPos ? "Bullish" : allBearPos ? "Bearish" : neutralContraction ? "Neutral Contraction" : "Neutral"

// ============================================================================
// STATUS TABLE
// Table layout: 4 columns × 6 rows (or 1 row in condensed mode)
//   Col 0: TF label | Col 1: Direction (U/D) | Col 2: Expand/Contract (E/C) | Col 3: Width metric
// ============================================================================
int _tableRows = condensedTable ? 1 : 6
var table statusTable = table.new(position.bottom_right, 4, _tableRows, bgcolor=color.new(color.black, 30), border_width=1)

if showTable and barstate.islast
    // Compute aggregate width metric: average across active "in status" TFs
    float _aggSum   = 0.0
    int   _aggCount = 0
    float _w1 = widthMetricType == "Percentile" ? tf1WidthPct : tf1WidthPctAvg
    float _w2 = widthMetricType == "Percentile" ? tf2WidthPct : tf2WidthPctAvg
    float _w3 = widthMetricType == "Percentile" ? tf3WidthPct : tf3WidthPctAvg
    float _w4 = widthMetricType == "Percentile" ? tf4WidthPct : tf4WidthPctAvg
    float _w5 = widthMetricType == "Percentile" ? tf5WidthPct : tf5WidthPctAvg
    if tf1InStatus and tf1Enabled and not na(_w1)
        _aggSum   += _w1
        _aggCount += 1
    if tf2InStatus and tf2Enabled and not na(_w2)
        _aggSum   += _w2
        _aggCount += 1
    if tf3InStatus and tf3Enabled and not na(_w3)
        _aggSum   += _w3
        _aggCount += 1
    if tf4InStatus and tf4Enabled and not na(_w4)
        _aggSum   += _w4
        _aggCount += 1
    if tf5InStatus and tf5Enabled and not na(_w5)
        _aggSum   += _w5
        _aggCount += 1
    string aggWidthStr = _aggCount > 0 ? str.tostring(math.round(_aggSum / _aggCount)) + "%" : "-"

    // Aggregated status row
    string aggDir  = (allBull or allBullPos) ? "U" : (allBear or allBearPos) ? "D" : "-"
    string aggEC   = (allBullExpanding or allBearExpanding) ? "E" : (allBullContracting or allBearContracting or neutralContraction) ? "C" : "-"
    color  aggBg   = (allBull or allBullPos) ? color.new(color.green, 40) : (allBear or allBearPos) ? color.new(color.red, 40) : color.new(color.gray, 40)
    table.cell(statusTable, 0, 0, "",          text_color=color.white, text_size=size.normal, bgcolor=aggBg)
    table.cell(statusTable, 1, 0, aggDir,      text_color=color.white, text_size=size.normal, bgcolor=aggBg)
    table.cell(statusTable, 2, 0, aggEC,       text_color=color.white, text_size=size.normal, bgcolor=aggBg)
    table.cell(statusTable, 3, 0, showWidthCol ? aggWidthStr : "", text_color=color.white, text_size=size.normal, bgcolor=aggBg)

    if not condensedTable
        // TF1 row
        bool tf1Active = tf1Enabled and not na(tf1Fast)
        bool tf1Exp    = tf1IsBull ? tf1BullExpanding : tf1BearExpanding
        bool tf1Con    = tf1IsBull ? tf1BullContracting : tf1BearContracting
        color tf1Bg    = not tf1Active ? color.new(color.gray, 60) : tf1IsBull ? color.new(color.green, 50) : color.new(color.red, 50)
        table.cell(statusTable, 0, 1, tf1Active ? formatTF(tf1TF) : "-",                      text_color=color.white, text_size=size.small, bgcolor=tf1Bg)
        table.cell(statusTable, 1, 1, tf1Active ? (tf1IsBull ? "U" : "D") : "-",              text_color=color.white, text_size=size.small, bgcolor=tf1Bg)
        table.cell(statusTable, 2, 1, tf1Active ? (tf1Exp ? "E" : tf1Con ? "C" : "-") : "-", text_color=color.white, text_size=size.small, bgcolor=tf1Bg)
        table.cell(statusTable, 3, 1, showWidthCol and tf1Active ? f_widthDisplay(tf1WidthPct, tf1WidthPctAvg, widthMetricType) : "", text_color=color.white, text_size=size.small, bgcolor=tf1Bg)

        // TF2 row
        bool tf2Active = tf2Enabled and not na(tf2Fast)
        bool tf2Exp    = tf2IsBull ? tf2BullExpanding : tf2BearExpanding
        bool tf2Con    = tf2IsBull ? tf2BullContracting : tf2BearContracting
        color tf2Bg    = not tf2Active ? color.new(color.gray, 60) : tf2IsBull ? color.new(color.green, 50) : color.new(color.red, 50)
        table.cell(statusTable, 0, 2, tf2Active ? formatTF(tf2TF) : "-",                      text_color=color.white, text_size=size.small, bgcolor=tf2Bg)
        table.cell(statusTable, 1, 2, tf2Active ? (tf2IsBull ? "U" : "D") : "-",              text_color=color.white, text_size=size.small, bgcolor=tf2Bg)
        table.cell(statusTable, 2, 2, tf2Active ? (tf2Exp ? "E" : tf2Con ? "C" : "-") : "-", text_color=color.white, text_size=size.small, bgcolor=tf2Bg)
        table.cell(statusTable, 3, 2, showWidthCol and tf2Active ? f_widthDisplay(tf2WidthPct, tf2WidthPctAvg, widthMetricType) : "", text_color=color.white, text_size=size.small, bgcolor=tf2Bg)

        // TF3 row
        bool tf3Active = tf3Enabled and not na(tf3Fast)
        bool tf3Exp    = tf3IsBull ? tf3BullExpanding : tf3BearExpanding
        bool tf3Con    = tf3IsBull ? tf3BullContracting : tf3BearContracting
        color tf3Bg    = not tf3Active ? color.new(color.gray, 60) : tf3IsBull ? color.new(color.green, 50) : color.new(color.red, 50)
        table.cell(statusTable, 0, 3, tf3Active ? formatTF(tf3TF) : "-",                      text_color=color.white, text_size=size.small, bgcolor=tf3Bg)
        table.cell(statusTable, 1, 3, tf3Active ? (tf3IsBull ? "U" : "D") : "-",              text_color=color.white, text_size=size.small, bgcolor=tf3Bg)
        table.cell(statusTable, 2, 3, tf3Active ? (tf3Exp ? "E" : tf3Con ? "C" : "-") : "-", text_color=color.white, text_size=size.small, bgcolor=tf3Bg)
        table.cell(statusTable, 3, 3, showWidthCol and tf3Active ? f_widthDisplay(tf3WidthPct, tf3WidthPctAvg, widthMetricType) : "", text_color=color.white, text_size=size.small, bgcolor=tf3Bg)

        // TF4 row
        bool tf4Active = tf4Enabled and not na(tf4Fast)
        bool tf4Exp    = tf4IsBull ? tf4BullExpanding : tf4BearExpanding
        bool tf4Con    = tf4IsBull ? tf4BullContracting : tf4BearContracting
        color tf4Bg    = not tf4Active ? color.new(color.gray, 60) : tf4IsBull ? color.new(color.green, 50) : color.new(color.red, 50)
        table.cell(statusTable, 0, 4, tf4Active ? formatTF(tf4TF) : "-",                      text_color=color.white, text_size=size.small, bgcolor=tf4Bg)
        table.cell(statusTable, 1, 4, tf4Active ? (tf4IsBull ? "U" : "D") : "-",              text_color=color.white, text_size=size.small, bgcolor=tf4Bg)
        table.cell(statusTable, 2, 4, tf4Active ? (tf4Exp ? "E" : tf4Con ? "C" : "-") : "-", text_color=color.white, text_size=size.small, bgcolor=tf4Bg)
        table.cell(statusTable, 3, 4, showWidthCol and tf4Active ? f_widthDisplay(tf4WidthPct, tf4WidthPctAvg, widthMetricType) : "", text_color=color.white, text_size=size.small, bgcolor=tf4Bg)

        // TF5 row
        bool tf5Active = tf5Enabled and not na(tf5Fast)
        bool tf5Exp    = tf5IsBull ? tf5BullExpanding : tf5BearExpanding
        bool tf5Con    = tf5IsBull ? tf5BullContracting : tf5BearContracting
        color tf5Bg    = not tf5Active ? color.new(color.gray, 60) : tf5IsBull ? color.new(color.green, 50) : color.new(color.red, 50)
        table.cell(statusTable, 0, 5, tf5Active ? formatTF(tf5TF) : "-",                      text_color=color.white, text_size=size.small, bgcolor=tf5Bg)
        table.cell(statusTable, 1, 5, tf5Active ? (tf5IsBull ? "U" : "D") : "-",              text_color=color.white, text_size=size.small, bgcolor=tf5Bg)
        table.cell(statusTable, 2, 5, tf5Active ? (tf5Exp ? "E" : tf5Con ? "C" : "-") : "-", text_color=color.white, text_size=size.small, bgcolor=tf5Bg)
        table.cell(statusTable, 3, 5, showWidthCol and tf5Active ? f_widthDisplay(tf5WidthPct, tf5WidthPctAvg, widthMetricType) : "", text_color=color.white, text_size=size.small, bgcolor=tf5Bg)

// ============================================================================
// ALERTS
// ============================================================================
bool statusChanged = alignment != alignment[1]

alertcondition(statusChanged and allBullExpanding,             "Bullish Expansion",    "EMA clouds entered Bullish Expansion")
alertcondition(statusChanged and allBearExpanding,             "Bearish Expansion",    "EMA clouds entered Bearish Expansion")
alertcondition(statusChanged and allBullContracting,           "Bullish Contraction",  "EMA clouds entered Bullish Contraction")
alertcondition(statusChanged and allBearContracting,           "Bearish Contraction",  "EMA clouds entered Bearish Contraction")
alertcondition(statusChanged and alignment == "Bullish",       "Bullish",              "EMA clouds entered Bullish")
alertcondition(statusChanged and alignment == "Bearish",       "Bearish",              "EMA clouds entered Bearish")
alertcondition(statusChanged and neutralContraction,           "Neutral Contraction",  "EMA clouds entered Neutral Contraction")
alertcondition(statusChanged and alignment == "Neutral",       "Neutral",              "EMA clouds entered Neutral")
alertcondition(statusChanged,                                  "Any Status Change",    "EMA cloud trend status changed")

// ============================================================================
// BACKGROUND COLORS
// ============================================================================
color bgCol = not showBgColor ? na : allBullExpanding ? bgBullishExpansion : allBearExpanding ? bgBearishExpansion : allBullContracting ? bgBullishContraction : allBearContracting ? bgBearishContraction : allBull ? bgBullish : allBear ? bgBearish : allBullPos ? bgBullish : allBearPos ? bgBearish : neutralContraction ? bgNeutralContraction : na
bgcolor(bgCol, title="Trend Status Background")
